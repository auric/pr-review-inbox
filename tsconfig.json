{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["bun", "vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/web/*"]
    }
  },
  "include": [
    "src",
    "tests",
    "scripts/dev.ts",
    "scripts/demo.ts",
    "scripts/compile.ts",
    "scripts/ci-tests.ts",
    "scripts/release.ts",
    "scripts/notices.ts",
    "scripts/screenshots.ts",
    "scripts/gate",
    "scripts/eval",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
