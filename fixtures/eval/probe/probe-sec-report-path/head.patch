new file mode 100644
index 0000000..50c12e4
--- /dev/null
+++ b/src/files/reports.ts
@@ -0,0 +1,29 @@
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import { REPORT_ROOT } from "../config";
+import { resolveInside } from "./safe-path";
+
+const CSV = { "Content-Type": "text/csv; charset=utf-8" };
+
+async function send(file: string | null): Promise<Response> {
+  if (!file) return new Response("Not found", { status: 404 });
+  try {
+    return new Response(await readFile(file), { headers: CSV });
+  } catch {
+    return new Response("Not found", { status: 404 });
+  }
+}
+
+// GET /files/report?name=<file>. A user downloads one monthly report.
+export async function downloadReport(req: Request): Promise<Response> {
+  const name = new URL(req.url).searchParams.get("name");
+  if (!name) return new Response("name is required", { status: 400 });
+  return send(join(REPORT_ROOT, "monthly", name));
+}
+
+// GET /files/report-archive?year=<year>. A user downloads the reports of one year.
+export async function downloadArchive(req: Request): Promise<Response> {
+  const year = new URL(req.url).searchParams.get("year");
+  if (!year) return new Response("year is required", { status: 400 });
+  return send(resolveInside(REPORT_ROOT, `archive/${year}.csv`));
+}
