new file mode 100644
index 0000000..381056c
--- /dev/null
+++ b/jobs/stats.py
@@ -0,0 +1,23 @@
+"""Counts the events by kind and logs the counts on each tick event."""
+
+import logging
+
+log = logging.getLogger(__name__)
+
+
+class EventStats:
+    """A handler for Dispatcher."""
+
+    def __init__(self):
+        self._counts = {}
+
+    def record(self, event):
+        if event.kind == "tick":
+            self._report()
+            return
+        self._counts[event.kind] = self._counts.get(event.kind, 0) + 1
+
+    def _report(self):
+        for kind, n in sorted(self._counts.items()):
+            log.info("events %s: %d", kind, n)
+        self._counts.clear()
diff --git a/tests/test_stats.py b/tests/test_stats.py
