index 0000000..ecba62c
--- /dev/null
+++ b/tests/test_stats.py
@@ -0,0 +1,15 @@
+import logging
+
+from jobs.events import Event
+from jobs.stats import EventStats
+
+
+def test_logs_and_clears_the_counts_on_tick(caplog):
+    caplog.set_level(logging.INFO)
+    stats = EventStats()
+    for kind in ["a", "b", "a"]:
+        stats.record(Event(kind=kind, payload={}))
+    stats.record(Event(kind="tick", payload={}))
+    assert [r.getMessage() for r in caplog.records] == ["events a: 2", "events b: 1"]
+    stats.record(Event(kind="tick", payload={}))
+    assert len(caplog.records) == 2
