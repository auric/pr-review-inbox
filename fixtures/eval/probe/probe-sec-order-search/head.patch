         (customer_id, status),
     ).fetchone()
     return row[0]
+
+
+# The sort keys of the API. Only these column names reach the SQL text.
+SORT_COLUMNS = {"newest": "created_at DESC", "oldest": "created_at ASC", "total": "total_cents DESC"}
+
+
+def search_orders(conn: sqlite3.Connection, customer_id: int, status: str, sort: str, limit: int):
+    column = SORT_COLUMNS.get(sort, SORT_COLUMNS["newest"])
+    order = f" ORDER BY {column}"
+    page = f" LIMIT {int(limit)}"
+    sql = f"SELECT id, status, total_cents FROM orders WHERE customer_id = ? AND status = '{status}'"
+    return conn.execute(sql + order + page, (customer_id,)).fetchall()
