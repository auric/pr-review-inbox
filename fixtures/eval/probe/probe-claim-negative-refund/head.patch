+"""Partial refunds of an order line to the wallet of the customer."""
+
+from shop.orders import Order
+from shop.quantity import QuantityError, parse_quantity
+from shop.wallet import Wallet
+
+
+def refund(order: Order, sku: str, quantity_text: str, wallet: Wallet) -> int:
+    """Refunds part of an order line. Returns the refunded amount in cents."""
+    line = order.lines.get(sku)
+    if line is None:
+        raise KeyError(sku)
+    quantity = parse_quantity(quantity_text)
+    if line.refunded + quantity > line.quantity:
+        raise QuantityError("more than the ordered quantity")
+    cents = quantity * line.price_cents
+    line.refunded += quantity
+    wallet.credit(order.customer, cents)
+    return cents
diff --git a/tests/test_refunds.py b/tests/test_refunds.py
new file mode 100644
