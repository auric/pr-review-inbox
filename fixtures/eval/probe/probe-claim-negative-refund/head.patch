@@ -0,0 +1,25 @@
+import pytest
+
+from shop.orders import Line, Order
+from shop.quantity import QuantityError
+from shop.refunds import refund
+from shop.wallet import Wallet
+
+
+def make_order():
+    order = Order(id="o-1", customer="c-1")
+    order.lines["sku-1"] = Line(sku="sku-1", price_cents=250, quantity=4)
+    return order
+
+
+def test_refunds_part_of_a_line():
+    order, wallet = make_order(), Wallet()
+    assert refund(order, "sku-1", "3", wallet) == 750
+    assert wallet.balance("c-1") == 750
+
+
+def test_rejects_more_than_ordered():
+    order, wallet = make_order(), Wallet()
+    refund(order, "sku-1", "3", wallet)
+    with pytest.raises(QuantityError):
+        refund(order, "sku-1", "2", wallet)
