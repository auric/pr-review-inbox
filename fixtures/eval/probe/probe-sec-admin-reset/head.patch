@@ -0,0 +1,13 @@
+from app.users import store
+
+
+def test_admin_gets_a_one_time_password(admin_client):
+    store._users[7] = store.User(id=7, email="user7@example.invalid")
+    res = admin_client.post("/admin/users/7/reset-password")
+    assert res.status_code == 200
+    assert len(res.json["temporaryPassword"]) >= 16
+    assert store.get(7).must_change_password
+
+
+def test_unknown_user_is_404(admin_client):
+    assert admin_client.post("/admin/users/999/reset-password").status_code == 404
