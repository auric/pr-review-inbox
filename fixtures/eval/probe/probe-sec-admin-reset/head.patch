 log = logging.getLogger(__name__)
@@ -30,3 +32,15 @@ def enable_user(user_id):
     store.set_disabled(user_id, False)
     log.info("user %s enabled by %s", user_id, g.user.id)
     return jsonify(ok=True)
+
+
+# The admin reads the one-time password to the user by phone. The user must change it at the next sign-in.
+@bp.post("/users/<int:user_id>/reset-password")
+@login_required
+def reset_password(user_id):
+    if store.get(user_id) is None:
+        return jsonify(error="no such user"), 404
+    temporary = secrets.token_urlsafe(12)
+    store.set_password(user_id, hash_password(temporary), must_change=True)
+    log.info("password of user %s reset by %s", user_id, g.user.id)
+    return jsonify(temporaryPassword=temporary)
