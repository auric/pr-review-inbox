+// Parses a quota value such as "500" or "2k".
+// Returns null for a missing, empty, zero, or malformed value. The caller picks the fallback.
+export function parseQuota(raw: string | undefined): number | null {
+  if (raw === undefined) return null;
+  const m = /^(\d+)(k?)$/.exec(raw.trim());
+  if (!m) return null;
+  const n = Number(m[1]) * (m[2] === "k" ? 1000 : 1);
+  return n > 0 ? n : null;
+}
