diff --git a/CMakeLists.txt b/CMakeLists.txt
index 161e4c5..8fdf0c0 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -9,6 +9,8 @@ if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
   # Only the symbols in geo.map leave the library.
   target_link_options(geo PRIVATE "-Wl,--version-script=${CMAKE_CURRENT_SOURCE_DIR}/geo.map")
   add_test(NAME exported_symbols COMMAND ${CMAKE_CURRENT_SOURCE_DIR}/tests/check_symbols.sh $<TARGET_FILE:geo>)
+elseif(APPLE)
+  set_target_properties(geo PROPERTIES MACOSX_RPATH ON INSTALL_NAME_DIR "@rpath")
 endif()
 
 enable_testing()
diff --git a/cmake/macos.cmake b/cmake/macos.cmake
new file mode 100644
index 0000000..e3044b7
--- /dev/null
+++ b/cmake/macos.cmake
@@ -0,0 +1,5 @@
+# Toolchain file for the macOS build of geo.
+set(CMAKE_OSX_DEPLOYMENT_TARGET "12.0" CACHE STRING "Oldest macOS version")
+# A CMake list: one universal binary for both CPU kinds.
+set(CMAKE_OSX_ARCHITECTURES "arm64;x86_64" CACHE STRING "CPU kinds")
+set(CMAKE_C_COMPILER clang)
diff --git a/docs/build.md b/docs/build.md
index b444c75..180c3cd 100644
--- a/docs/build.md
+++ b/docs/build.md
@@ -1,3 +1,6 @@
 # Build
 
 Linux: `cmake -B build && cmake --build build && ctest --test-dir build`.
+
+macOS: `cmake -B build -DCMAKE_TOOLCHAIN_FILE=cmake/macos.cmake && cmake --build build`.
+The result is one universal library for arm64 and x86_64.
