@@ -0,0 +1,10 @@
+export type Preview = { url: string; title: string | null };
+
+// Shows the preview of a pasted link under the chat message.
+export function LinkCard({ preview }: { preview: Preview }) {
+  return (
+    <a className="link-card" href={preview.url} target="_blank" rel="noreferrer">
+      {preview.title ?? preview.url}
+    </a>
+  );
+}
