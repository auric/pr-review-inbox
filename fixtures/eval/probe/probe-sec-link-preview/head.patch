new file mode 100644
index 0000000..423a778
--- /dev/null
+++ b/src/links/preview.ts
@@ -0,0 +1,12 @@
+import { readLimited } from "../net/read";
+
+const TITLE = /<title[^>]*>([^<]*)<\/title>/i;
+
+// POST /api/link-preview with the JSON body { url }. The chat client sends each link that a user pastes into a message.
+export async function linkPreview(req: Request): Promise<Response> {
+  const { url } = (await req.json().catch(() => ({}))) as { url?: unknown };
+  if (typeof url !== "string" || !/^https?:\/\//i.test(url)) return new Response("Bad URL", { status: 400 });
+  const res = await fetch(url, { signal: AbortSignal.timeout(5000) });
+  const html = await readLimited(res, 65_536);
+  return Response.json({ url, title: TITLE.exec(html)?.[1]?.trim() || null });
+}
