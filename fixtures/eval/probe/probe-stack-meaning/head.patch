+import type { Db } from "../db/types";
+import { customerOrders } from "../orders/store";
+
+const YEAR_MS = 365 * 24 * 60 * 60 * 1000;
+
+// A customer whose first order is two or more years old gets the loyalty discount.
+export function hasLoyaltyDiscount(db: Db, customerId: string, now: number): boolean {
+  const first = customerOrders(db, customerId)[0];
+  return first !== undefined && now - first.createdAt >= 2 * YEAR_MS;
+}
