@@ -0,0 +1,23 @@
+import { collect } from "./collect";
+import type { Row, Sample } from "./types";
+
+export const LIMIT_MS = 800;
+export const WINDOW_MS = 5 * 60_000;
+
+export function averageMs(samples: readonly Sample[]): number {
+  let total = 0;
+  let count = 0;
+  for (const s of samples) {
+    if (s.ms == null) continue;
+    total += s.ms;
+    count++;
+  }
+  return total / count;
+}
+
+export function latencyRows(all: readonly Sample[], endpoints: readonly string[], now: number): Row[] {
+  return endpoints.map((endpoint): Row => {
+    const avg = averageMs(collect(all, endpoint, now - WINDOW_MS));
+    return { endpoint, averageMs: Math.round(avg), status: avg <= LIMIT_MS ? "ok" : "slow" };
+  });
+}
