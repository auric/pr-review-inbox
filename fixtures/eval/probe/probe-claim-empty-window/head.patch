+import { describe, expect, test } from "vitest";
+import { averageMs, latencyRows } from "../../src/metrics/latency";
+
+describe("latency", () => {
+  test("averages the samples with a response time", () => {
+    const at = (t: number, ms: number | null) => ({ endpoint: "/a", at: t, ms });
+    expect(averageMs([at(1, 100), at(2, null), at(3, 300)])).toBe(200);
+  });
+
+  test("marks an endpoint over the limit as slow", () => {
+    const now = 10 * 60_000;
+    const samples = [
+      { endpoint: "/a", at: now - 1000, ms: 900 },
+      { endpoint: "/b", at: now - 1000, ms: 100 },
+    ];
+    expect(latencyRows(samples, ["/a", "/b"], now).map((r) => r.status)).toEqual(["slow", "ok"]);
+  });
+});
