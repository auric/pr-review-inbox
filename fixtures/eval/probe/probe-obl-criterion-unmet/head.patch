+++ b/src/signup/password.ts
@@ -0,0 +1,9 @@
+const MIN_LENGTH = 12;
+
+// Returns the rules that the password breaks. An empty list means that the password is valid.
+export function passwordErrors(password: string): string[] {
+  const errors: string[] = [];
+  if (password.length < MIN_LENGTH) errors.push(`Use at least ${MIN_LENGTH} characters.`);
+  if (!/[0-9]/.test(password)) errors.push("Use at least one digit.");
+  return errors;
+}
