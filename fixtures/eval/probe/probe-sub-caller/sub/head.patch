-  if (raw === "unlimited") return -1;
+// Parses a quota setting. "unlimited" gives null, so no number stands for "no limit". A value that is not a number gives 0.
+export function parseQuota(raw: string): number | null {
+  if (raw === "unlimited") return null;
   const n = Number.parseInt(raw, 10);
   return Number.isNaN(n) ? 0 : n;
 }
