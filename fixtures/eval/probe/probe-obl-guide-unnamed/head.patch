+++ b/tests/upload/limits.test.ts
@@ -0,0 +1,14 @@
+import { expect, test } from "vitest";
+import { checkSize, MAX_UPLOAD_BYTES } from "../../src/upload/limits";
+
+test("the limit is 25 MB", () => {
+  expect(MAX_UPLOAD_BYTES).toBe(25 * 1024 * 1024);
+});
+
+test("a file of exactly 25 MB uploads", () => {
+  expect(() => checkSize(25 * 1024 * 1024)).not.toThrow();
+});
+
+test("a larger file fails", () => {
+  expect(() => checkSize(25 * 1024 * 1024 + 1)).toThrow(RangeError);
+});
