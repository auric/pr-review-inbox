+import { allow } from "./limit";
 import type { Handler, Reply, Request } from "./types";
 
 export function serve(handler: Handler): (req: Request) => Reply {
-  return (req) => handler(req);
+  return (req) => {
+    if (!allow(req.apiKey, req.now)) return { status: 429, headers: {}, body: "Too many requests." };
+    return handler(req);
+  };
 }
