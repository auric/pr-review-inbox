diff --git a/tests/test_lockout.py b/tests/test_lockout.py
new file mode 100644
index 0000000..b6a88d4
--- /dev/null
+++ b/tests/test_lockout.py
@@ -0,0 +1,30 @@
+import pytest
+
+from auth.lockout import FAILS_MAX, LOCK_S, Lockout
+from auth.login import LoginError, login
+
+
+class Clock:
+    def __init__(self):
+        self.now = 1000.0
+
+    def __call__(self):
+        return self.now
+
+
+def test_locks_after_five_failures():
+    clock = Clock()
+    lockout = Lockout(clock)
+    for _ in range(FAILS_MAX):
+        lockout.failed("ada")
+    assert lockout.locked("ada")
+    clock.now += LOCK_S
+    assert not lockout.locked("ada")
+
+
+def test_a_locked_account_gets_the_locked_error():
+    lockout = Lockout(Clock())
+    for _ in range(FAILS_MAX):
+        lockout.failed("ada")
+    with pytest.raises(LoginError, match="locked"):
+        login("ada", "right", {}, lockout)
