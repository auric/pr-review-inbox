diff --git a/auth/lockout.py b/auth/lockout.py
new file mode 100644
index 0000000..6fa7604
--- /dev/null
+++ b/auth/lockout.py
@@ -0,0 +1,24 @@
+"""Locks an account after too many failed logins."""
+
+FAILS_MAX = 5
+WINDOW_S = 15 * 60
+LOCK_S = 15 * 60
+
+
+class Lockout:
+    def __init__(self, clock):
+        self._clock = clock
+        self._fails = {}
+        self._locked_until = {}
+
+    def locked(self, account):
+        return self._clock() < self._locked_until.get(account, 0)
+
+    def failed(self, account):
+        now = self._clock()
+        recent = [t for t in self._fails.get(account, []) if now - t < WINDOW_S]
+        recent.append(now)
+        if len(recent) >= FAILS_MAX:
+            self._locked_until[account] = now + LOCK_S
+            recent = []
+        self._fails[account] = recent
