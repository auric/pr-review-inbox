+import { expect, test } from "vitest";
+import { formatBytes } from "../../src/ui/format";
+
+test("formats each unit", () => {
+  const sizes = [0, 1023, 1024, 1536, 1024 ** 2 - 1, 5 * 1024 ** 2, 2 * 1024 ** 3];
+  expect(sizes.map(formatBytes)).toEqual(["0 B", "1023 B", "1.0 KiB", "1.5 KiB", "1.0 MiB", "5.0 MiB", "2.0 GiB"]);
+});
