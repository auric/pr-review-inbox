@@ -0,0 +1,11 @@
+import { expect, test } from "vitest";
+import { ordersCsv } from "../../src/export/csv";
+
+test("writes the header and one row per order", () => {
+  const order = { id: "o-1", day: "2026-01-02", customer: "Ada", totalCents: 1250 };
+  expect(ordersCsv([order])).toBe("id,customer,total\r\no-1,Ada,12.50\r\n");
+});
+
+test("an empty list gives the header only", () => {
+  expect(ordersCsv([])).toBe("id,customer,total\r\n");
+});
