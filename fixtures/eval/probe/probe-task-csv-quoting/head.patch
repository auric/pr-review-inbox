@@ -0,0 +1,7 @@
+import { ordersOf } from "../orders/list";
+import type { Order } from "../orders/types";
+import { ordersCsv } from "./csv";
+
+export function exportDay(all: readonly Order[], day: string): { type: string; body: string } {
+  return { type: "text/csv; charset=utf-8", body: ordersCsv(ordersOf(all, day)) };
+}
