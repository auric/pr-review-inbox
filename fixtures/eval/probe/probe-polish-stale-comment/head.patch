+++ b/tests/contacts/dedupe.test.ts
@@ -0,0 +1,14 @@
+import { expect, test } from "vitest";
+import { dedupe } from "../../src/contacts/dedupe";
+
+test("the newest entry for an email wins", () => {
+  const old = { name: "Ann", email: "ann@example.com", updatedAt: 1 };
+  const next = { name: "Ann Lee", email: "Ann@Example.com ", updatedAt: 2 };
+  expect(dedupe([old, next])).toEqual([next]);
+});
+
+test("different emails stay apart, in input order", () => {
+  const a = { name: "A", email: "a@example.com", updatedAt: 1 };
+  const b = { name: "B", email: "b@example.com", updatedAt: 1 };
+  expect(dedupe([a, b])).toEqual([a, b]);
+});
