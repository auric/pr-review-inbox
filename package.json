{
  "name": "pr-review-inbox",
  "description": "A local-first inbox for Bitbucket Server pull requests, with AI reviews by your own Claude Code CLI.",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auric/pr-review-inbox.git"
  },
  "homepage": "https://github.com/auric/pr-review-inbox#readme",
  "bugs": {
    "url": "https://github.com/auric/pr-review-inbox/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "vite build",
    "start": "bun src/server/main.ts",
    "demo": "bun scripts/demo.ts",
    "compile": "bun scripts/compile.ts",
    "compile:all": "bun scripts/compile.ts --all",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "typecheck:5": "node node_modules/typescript-5/bin/tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "check": "bun run typecheck && bun run typecheck:5 && bun run lint && bun test --timeout 30000",
    "release": "bun scripts/release.ts",
    "notices": "bun scripts/notices.ts",
    "eval": "bun scripts/eval/run.ts",
    "eval:compare": "bun scripts/eval/compare.ts",
    "eval:rescore": "bun scripts/eval/rescore.ts",
    "eval:local": "bun scripts/eval/local.ts",
    "eval:ab": "bun scripts/eval/ab.ts",
    "gate:ci": "bun scripts/gate/ci.ts",
    "screenshots": "bun run build && node scripts/screenshots.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tanstack/react-query": "5.104.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "hono": "4.13.13",
    "lucide-react": "1.52.0",
    "mermaid": "12.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "shadcn": "4.21.4",
    "turndown": "7.2.4",
    "tw-animate-css": "1.4.0",
    "unified": "11.0.5",
    "xstate": "5.33.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-5": "npm:typescript@5.9.3",
    "vite": "8.3.3"
  }
}
